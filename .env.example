# Copy this file to ".env" and fill in your real key, then:
#   set -a; source .env; set +a    # load into your shell
# .env is gitignored — your key must NEVER be committed.
#
# --- kie.ai (tools/generate-images.mjs) ---
# Get / rotate your key at https://kie.ai (dashboard → API keys).
KIE_API_KEY=your-kie-ai-key-here

# --- Higgsfield (tools/generate-higgsfield.mjs) ---
# Credentials are a PAIR in KEY_ID:KEY_SECRET form.
# Get them at https://cloud.higgsfield.ai → API keys.
HF_CREDENTIALS=YOUR_KEY_ID:YOUR_KEY_SECRET
